{
  "name": "conjoint-companion-desktop",
  "private": true,
  "description": "Offline desktop companion app for test-retest reliability workflows in metric conjoint experiments.",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/drdiscipulus/conjoint_desktop_app.git"
  },
  "homepage": "https://shiny.drdiscipulus.de/conjoint_app/",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "prepare:shiny": "node scripts/sync_shiny_app.mjs",
    "prepare:runtime": "npm run prepare:shiny && node scripts/stage_r_runtime.mjs",
    "tauri:dev": "npm run prepare:shiny && tauri dev",
    "tauri:build": "npm run prepare:runtime && tauri build --no-bundle",
    "tauri:build:windows": "npm run prepare:runtime && tauri build --no-bundle",
    "check:macos-notarization": "node scripts/check_macos_notarization_env.mjs",
    "tauri:build:macos": "node scripts/release_macos_portable.mjs --build-only",
    "export:portable": "node scripts/export_portable.mjs",
    "release:portable": "node scripts/release_portable.mjs",
    "release:portable:windows": "npm run tauri:build:windows && npm run export:portable",
    "release:portable:macos": "node scripts/release_macos_portable.mjs",
    "check:shiny": "Rscript src-tauri/resources/shiny-app/scripts/check_app.R"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "vite": "^5.4.8"
  }
}
