APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)

# Recommended: store notarization credentials in the login keychain with
# xcrun notarytool store-credentials "conjoint-companion-notary" \
#   --apple-id "your-apple-id@example.com" --team-id "TEAMID"
APPLE_NOTARY_PROFILE=conjoint-companion-notary

# Alternative: provide all three Apple ID values instead of a keychain profile.
APPLE_ID=your-apple-id@example.com
APPLE_PASSWORD=your-app-specific-password
APPLE_TEAM_ID=TEAMID
